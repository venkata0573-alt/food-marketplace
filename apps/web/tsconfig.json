{
  "extends": "@food-marketplace/config/tsconfig/strict-react.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "target": "ES2022",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "middleware.ts",
    "next-env.d.ts",
    "next.config.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "src/**/*.a11y.test.tsx"]
}
