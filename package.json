{
  "name": "food-marketplace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts' --exclude '**/*.a11y.test.tsx' --exclude 'tests/performance/**' --exclude 'tests/contracts/**'",
    "test:integration": "vitest run 'tests/db/**/*.integration.test.ts' --exclude 'tests/db/rls-policies.integration.test.ts'",
    "test:rls": "vitest run tests/db/rls-policies.integration.test.ts",
    "test:contracts": "vitest run tests/contracts",
    "test:coverage": "vitest run --coverage --exclude '**/*.integration.test.ts' --exclude '**/*.a11y.test.tsx' --exclude 'tests/performance/**' --exclude 'tests/contracts/**'",
    "test:a11y": "vitest run packages/ui/src/a11y apps/web/src/client/forms/checkout-form.a11y.test.tsx",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:db:ci": "bash scripts/ci/db-integration.sh",
    "test:watch": "vitest",
    "perf:check": "node scripts/perf/check-no-offset.mjs && vitest run tests/performance",
    "load:k6": "k6 run load/k6/dinner-burst.js",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "dev:seed": "pnpm --filter @food-marketplace/db seed",
    "jobs:retention": "pnpm --filter @food-marketplace/jobs retention:all",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@food-marketplace/config": "workspace:*",
    "@food-marketplace/domain": "workspace:*",
    "@food-marketplace/rate-limit": "workspace:*",
    "@food-marketplace/resilience": "workspace:*",
    "@food-marketplace/auth": "workspace:*",
    "@food-marketplace/shared": "workspace:*",
    "@food-marketplace/db": "workspace:*",
    "@food-marketplace/shared-types": "workspace:*",
    "@changesets/cli": "^2.27.12",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.21.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.7",
    "vitest-axe": "^0.1.0",
    "zod": "^3.24.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'pnpm typecheck'"
    ]
  }
}
