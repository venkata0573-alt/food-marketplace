{
  "name": "@food-marketplace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seed/plan": {
      "types": "./src/seed/plan.ts",
      "default": "./src/seed/plan.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:down": "tsx scripts/migrate-down.ts",
    "seed": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "verify:migrations": "bash ../../scripts/verify-migration-pairs.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@food-marketplace/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
