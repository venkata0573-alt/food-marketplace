# Local development only — copy to `.env.local` (gitignored).
# Production and staging credentials are set in Vercel, not on developer machines.

APP_ENV=local
NODE_ENV=development

# Server-only (never NEXT_PUBLIC_)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/food_marketplace
# Direct Postgres (migrations / admin only — app runtime uses PgBouncer above)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/food_marketplace
REDIS_URL=redis://127.0.0.1:6379
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_test_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
FEATURE_FLAGS_JSON={"batch_delivery":false}
LOCAL_PII_ENCRYPTION_KEY=local-dev-only-change-me

# Supabase Auth (Layer 4)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role
AUTH_CSRF_SECRET=replace-with-at-least-16-chars
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=

# MinIO (S3-compatible) — photos
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=food-photos
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Mailpit (local SMTP capture)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Client-safe (may be embedded in the browser bundle)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_stripe_test_publishable
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
